# Copy to .env.local. Every value is optional for local work: empty counts as unset,
# and the app and all check scripts run without any env file.

# Public: Supabase project URL, e.g. http://127.0.0.1:54321 (inlined into the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=

# Public: Supabase publishable (or legacy anon) key, safe for the browser. Never put a service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Hadith API base URL (a trailing slash is stripped). Defaults to https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1 when empty.
HADITH_API_BASE_URL=
